# INWX-Webspace (Go-Live M6, 24.09.2026). Auf GitHub Pages ohne Wirkung.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /index.html

RewriteEngine On
# immer https, immer ohne www - nur fuer root-index.de
# (root-index.com dient waehrend des Umzugs als Testadresse und wird nicht umgeleitet)
# INWX beendet SSL vor dem Server: %{HTTPS} ist dort immer "off" -> Endlosschleife
# (25.09.2026). Deshalb https nur ueber X-Forwarded-Proto erzwingen, www immer weg.
RewriteCond %{HTTP_HOST} ^www\.root-index\.de$ [NC]
RewriteRule ^ https://root-index.de%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^root-index\.de$ [NC]
RewriteCond %{HTTP:X-Forwarded-Proto} =http [NC]
RewriteRule ^ https://root-index.de%{REQUEST_URI} [R=301,L]

<FilesMatch "\.(html)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(js|css)$">
  Header set Cache-Control "public, max-age=600"
</FilesMatch>
<FilesMatch "\.(png|jpg|jpeg|webp|svg|woff2?|ico)$">
  Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
# (steht NACH den allgemeinen Regeln, sonst ueberschreibt js|css ihn)
# Service Worker nie zwischenspeichern, sonst kommen Updates nicht an
<Files "sw.js">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</Files>
<FilesMatch "^\.(deploy-sha|git)">
  Require all denied
</FilesMatch>
